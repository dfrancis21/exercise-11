# Load and clean data

```{r}
#| label: load-libraries-data
#| warning: false
#| message: false

library(tidyverse)

measles_yearly <- measles |>
  filter(!is.na(year), !is.na(region_nice), !is.na(cases)) |>
  group_by(year, region_nice) |>
  summarise(
    total_cases = sum(cases),
    .groups = "drop"
  )

ggplot(
  measles_yearly,
  aes(
    x = year,
    y = total_cases,
    color = region_nice,
    group = region_nice
  )
) +
  geom_line(linewidth = 1) +
  labs(
    title = "Measles cases vary across WHO regions over time",
    subtitle = "Annual reported cases by region",
    x = "Year",
    y = "Reported measles cases",
    color = "WHO region",
    caption = "Source: WHO measles surveillance data."
  ) +
  scale_y_continuous(
    labels = scales::label_comma()
  ) +
  scale_color_brewer(palette = "Dark2") +
  theme_minimal(base_size = 12) +
  theme(
    plot.title = element_text(
      face = "bold",
      size = 16
    ),
    plot.subtitle = element_text(color = "grey35"),
    legend.position = "bottom",
    panel.grid.minor = element_blank(),
    panel.grid.major.x = element_blank(),
    plot.caption = element_text(
      color = "grey40",
      hjust = 0
    )
  )
```

